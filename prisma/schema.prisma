datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// USUARIOS Y AUTENTICACIÓN (RBAC)
// -------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          String    @default("RECEPTIONIST") // "ADMIN" | "RECEPTIONIST" | "DENTIST"
  isActive      Boolean   @default(true)
  phone         String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignedAppointments Appointment[] @relation("DentistAppointments")
  assignedChats        Conversation[]
  internalNotes        InternalNote[]
  auditLogs            AuditLog[]
  professionalProfile  Professional?

  @@index([email])
  @@index([role])
}

model Professional {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty        String   // "Odontología General", "Ortodoncia", "Endodoncia", etc.
  activeDays       String   @default("1,2,3,4,5,6") // Días laborales: 1=Lun ... 6=Sáb
  startHour        String   @default("08:00") // Formato 24h HH:mm
  endHour          String   @default("17:00")
  lunchStart       String   @default("12:00")
  lunchEnd         String   @default("13:00")
  slotIntervalMin  Int      @default(30)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  services         ProfessionalService[]
  waitingListItems WaitingList[]
}

// -------------------------------------------------------------
// CATÁLOGO DE SERVICIOS
// -------------------------------------------------------------
model Service {
  id               String   @id @default(cuid())
  name             String
  category         String   @default("General") // Limpieza, Restauración, Estética, Cirugía
  description      String?  // Orientativo para el prompt de la IA
  durationMinutes  Int      @default(30)
  price            Float    // Precio base en USD
  isPriceVariable  Boolean  @default(false) // Si es "Sujeto a valoración clínica previa"
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  professionals    ProfessionalService[]
  appointments     Appointment[]
  waitingListItems WaitingList[]

  @@index([isActive])
}

model ProfessionalService {
  id             String       @id @default(cuid())
  professionalId String
  serviceId      String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
}

// -------------------------------------------------------------
// PACIENTES Y CONTACTOS
// -------------------------------------------------------------
model Patient {
  id                 String    @id @default(cuid())
  fullName           String
  phoneNormalized    String    @unique // Formato internacional: ej. +50371234567
  email              String?
  birthDate          DateTime?
  tags               String    @default("Nuevo") // Lista separada por comas: "Nuevo,VIP,Ortodoncia"
  generalNotes       String?
  reminderPreference String    @default("WHATSAPP") // "WHATSAPP", "EMAIL", "NONE"
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  appointments       Appointment[]
  conversations      Conversation[]
  waitingListItems   WaitingList[]

  @@index([phoneNormalized])
  @@index([fullName])
}

// -------------------------------------------------------------
// CITAS Y CALENDARIO (REGLA ANTI-COLISIÓN)
// -------------------------------------------------------------
model Appointment {
  id             String    @id @default(cuid())
  patientId      String
  professionalId String
  serviceId      String
  startTime      DateTime
  endTime        DateTime
  status         String    @default("CONFIRMED") // "REQUESTED" | "CONFIRMED" | "IN_PROGRESS" | "COMPLETED" | "CANCELLED" | "NO_SHOW"
  origin         String    @default("MANUAL")    // "WHATSAPP_AI" | "RECEPTION" | "MANUAL"
  adminNotes     String?
  cancelReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  professional   User      @relation("DentistAppointments", fields: [professionalId], references: [id], onDelete: Restrict)
  service        Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  reminderLogs   ReminderLog[]
  payment        Payment?

  @@index([professionalId, startTime, endTime])
  @@index([patientId])
  @@index([status])
}

// -------------------------------------------------------------
// BANDEJA COMPARTIDA DE WHATSAPP (ESTILO CHATWOOT)
// -------------------------------------------------------------
model Conversation {
  id             String         @id @default(cuid())
  patientId      String
  whatsappJid    String         @unique // ej: 50371234567@s.whatsapp.net
  status         String         @default("OPEN") // "OPEN" | "PENDING_HUMAN" | "RESOLVED"
  isAiActive     Boolean        @default(true)   // True=IA responde; False=Pausada por humano
  assignedUserId String?
  lastMessageAt  DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  assignedUser   User?          @relation(fields: [assignedUserId], references: [id])
  messages       Message[]
  internalNotes  InternalNote[]

  @@index([status])
  @@index([isAiActive])
  @@index([assignedUserId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderType     String       // "PATIENT" | "AGENT" | "AI" | "SYSTEM"
  senderName     String?      // Nombre del agente humano si aplica
  text           String
  mediaUrl       String?
  mediaType      String?      // "image", "audio", "document"
  status         String       @default("SENT") // "SENT" | "DELIVERED" | "READ" | "FAILED"
  baileysMsgId   String?      @unique
  rawPayload     String?      // Payload en JSON para auditoría técnica
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model InternalNote {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  content        String
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// -------------------------------------------------------------
// LISTA DE ESPERA Y CANCELACIONES
// -------------------------------------------------------------
model WaitingList {
  id                    String        @id @default(cuid())
  patientId             String
  preferredServiceId    String?
  preferredDentistId    String?
  availableDays         String?       // "Lunes, Miércoles, Viernes"
  preferredTimeWindow   String?       // "Mañana" | "Tarde"
  status                String        @default("ACTIVE") // "ACTIVE" | "OFFERED" | "CONVERTED" | "CANCELLED"
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  patient               Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  preferredService      Service?      @relation(fields: [preferredServiceId], references: [id])
  preferredDentist      Professional? @relation(fields: [preferredDentistId], references: [id])

  @@index([status])
}

// -------------------------------------------------------------
// RECORDATORIOS AUTOMATIZADOS
// -------------------------------------------------------------
model ReminderLog {
  id            String      @id @default(cuid())
  appointmentId String
  type          String      // "24_HOURS" | "2_HOURS"
  status        String      @default("PENDING") // "SENT" | "FAILED" | "CANCELLED"
  scheduledFor  DateTime
  sentAt        DateTime?
  errorDetail   String?
  createdAt     DateTime    @default(now())

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, type])
  @@index([status, scheduledFor])
}

// -------------------------------------------------------------
// PAGOS Y PREPARACIÓN FASE 2 (FACTURACIÓN ELECTRÓNICA DTE)
// -------------------------------------------------------------
model Payment {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  amount        Float
  method        String      @default("CASH") // "CASH" | "CARD" | "TRANSFER" | "BITCOIN"
  status        String      @default("PAID") // "PENDING" | "PAID" | "REFUNDED"
  reference     String?     // Voucher o número de transacción
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// CONFIGURACIÓN DE CLÍNICA Y CONTROL DE IA / WHATSAPP
// -------------------------------------------------------------
model ClinicConfig {
  id                    String   @id @default("clinic_default")
  clinicName            String   @default("Clínica Dental Dra. Bianca Hernández")
  clinicAddress         String   @default("San Salvador, El Salvador")
  clinicPhone           String   @default("+50322000000")
  parkingInfo           String   @default("Parqueo privado gratuito para pacientes frente a la clínica.")
  holidaysJson          String   @default("[]") // Lista de fechas festivas YYYY-MM-DD
  
  // Parámetros de IA
  aiModel               String   @default("google/gemini-2.5-flash")
  aiTemperature         Float    @default(0.2)
  aiBufferSeconds       Int      @default(8)
  aiSystemPrompt        String   @default("Eres el Asistente Virtual Oficial de la Clínica Dental Dra. Bianca Nathaly Hernández Flores en El Salvador. Eres cordial, profesional, hablas en español salvadoreño educado y ayudas a los pacientes con información de servicios y agendamiento.")
  aiIsGloballyActive    Boolean  @default(true)

  // Estado WhatsApp
  whatsappSessionStatus String   @default("DISCONNECTED") // "CONNECTED" | "DISCONNECTED" | "SCAN_QR" | "CONNECTING"
  whatsappConnectedNumber String?
  whatsappLastQr        String?  // Base64 Data URL del QR para renderizado inmediato
  updatedAt             DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // "CREATE_APPOINTMENT", "PAUSE_AI", "DELETE_PATIENT", etc.
  entity    String
  entityId  String?
  details   String?  // JSON stringified
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
}

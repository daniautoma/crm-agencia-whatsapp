# ========================================================
# daniautoma - CRM OPERATIVO & AGENTE IA (.env.example)
# Despliegue oficial: https://crm.daniautoma.cloud
# ========================================================

# Base de Datos (SQLite local o PostgreSQL en servidor Dokploy / Coolify)
# SQLite dev: "file:./dev.db"
# Postgres prod: "postgresql://usuario:password@host:5432/daniautoma_crm?schema=public"
DATABASE_URL="file:./dev.db"

# Clave secreta para firma de cookies JWT (mínimo 32 caracteres)
JWT_SECRET="reemplazar_con_cadena_aleatoria_segura_de_32_caracteres"

# Credenciales para el Seed inicial del Administrador
ADMIN_EMAIL="admin@daniautoma.cloud"
ADMIN_PASSWORD="ReemplazarConPasswordSeguro123!"

# Motor de Inteligencia Artificial (OpenRouter API)
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="google/gemini-2.5-flash"

# Directorio de persistencia de credenciales Baileys WhatsApp
BAILEYS_AUTH_DIR="./baileys_auth"

# Clave de comunicación interna entre Next.js y el daemon de WhatsApp
WORKER_INTERNAL_SECRET="generar_token_aleatorio_para_loopback_api"
PORT="3000"
WORKER_PORT="3001"

# Notificaciones y Correos Transaccionales (Resend / SMTP)
RESEND_API_KEY="re_..."
EMAIL_FROM="Esteban de daniautoma <notificaciones@daniautoma.cloud>"
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS=""

# Dominio de Producción
NEXT_PUBLIC_APP_URL="https://crm.daniautoma.cloud"

# ========================================================
# CRM DANIAUTOMA - PLANTILLA DE VARIABLES (.env.example)
# ========================================================

# Base de Datos (SQLite local o PostgreSQL en servidor Dokploy)
# SQLite dev: "file:./dev.db"
# Postgres prod: "postgresql://usuario:password@host:5432/crm_daniautoma?schema=public"
DATABASE_URL="file:./dev.db"

# Clave secreta para firma de cookies JWT (mínimo 32 caracteres)
JWT_SECRET="reemplazar_con_cadena_aleatoria_segura_de_32_caracteres"

# Credenciales para el Seed inicial del Administrador
ADMIN_EMAIL=admin@daniautoma.cloud
ADMIN_PASSWORD="AdminAutoma2025!"

# Variables para envío de correos transaccionales
MAIL_FROM=contacto@daniautoma.cloud
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Motor de Inteligencia Artificial (OpenRouter API)
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="google/gemini-2.5-flash"

# Directorio de persistencia de credenciales Baileys
BAILEYS_AUTH_DIR="./baileys_auth"

# Clave de comunicación interna entre Next.js y el daemon de WhatsApp
WORKER_INTERNAL_SECRET="generar_token_aleatorio_para_loopback_api"
PORT="3000"
WORKER_PORT="3001"
